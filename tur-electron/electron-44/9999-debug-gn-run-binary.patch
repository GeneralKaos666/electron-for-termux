--- a/build/gn_run_binary.py
+++ b/build/gn_run_binary.py
@@ -19,6 +19,45 @@
 path = sys.argv[1]
 if not os.path.isabs(path):
   path = './' + path
 
+# TEMP-DEBUG (Termux electron-44 bringup, to be reverted): locate any
+# non-RELATIVE entry inside the DT_RELACOUNT leading run of .rela.dyn.
+if os.path.basename(path) == 'root_store_tool':
+  try:
+    _readobj = os.path.join(
+        os.path.dirname(os.path.abspath(__file__)), '..', 'third_party',
+        'llvm-build', 'Release+Asserts', 'bin', 'llvm-readobj')
+    _out = subprocess.run(
+        [_readobj, '--relocations', path],
+        capture_output=True,
+        text=True,
+        timeout=120).stdout
+    _section = None
+    _idx = -1
+    _odd = []
+    _at = {}
+    for _line in _out.splitlines():
+      _s = _line.strip()
+      if _s.startswith('Section '):
+        _section = _s
+        _idx = -1
+        continue
+      _parts = _s.split()
+      if len(_parts) >= 2 and _parts[0].startswith('0x'):
+        _idx += 1
+        _t = _parts[1]
+        if _section is not None and '.rela.dyn' in _section:
+          _at[_idx] = _t
+          if _t not in ('R_X86_64_RELATIVE', 'R_X86_64_RELATIVE64'):
+            _odd.append((_idx, _t, _parts[0]))
+    print('TERMUX-DEBUG non-relative in .rela.dyn: %r' % (_odd,))
+    print('TERMUX-DEBUG boundary[4230:4242]: %r' %
+          ([(i, _at.get(i)) for i in range(4230, 4242)],))
+    print('TERMUX-DEBUG env: LD_LIBRARY_PATH=%r LD_PRELOAD=%r' % (os.environ.get('LD_LIBRARY_PATH'), os.environ.get('LD_PRELOAD'),))
+  except Exception as _e:  # never break the build over diagnostics
+    print('TERMUX-DEBUG inspection failed: %r' % (_e,))
+  # Show exactly which relocation the loader chokes on.
+  os.environ['LD_DEBUG'] = 'reloc'
+
 # The rest of the arguments are passed directly to the executable.
 args = [path] + sys.argv[2:]
