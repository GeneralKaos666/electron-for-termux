--- a/build/gn_run_binary.py
+++ b/build/gn_run_binary.py
@@ -20,6 +20,57 @@
 if not os.path.isabs(path):
   path = './' + path
 
+# TEMP-DEBUG (Termux electron-44 bringup, to be reverted): the libffi
+# lead is dead (NEEDED/ldd/LD_DEBUG=libs all clean) yet the RELACOUNT
+# assert persists, so dump the CURRENT binary's own relocation layout:
+# RELACOUNT value, reloc type counts, first non-RELATIVE index in
+# .rela.dyn, RELR/CREL section presence, and embedded ffi symbols.
+if os.path.basename(path) == 'root_store_tool':
+  try:
+    _bd = os.path.dirname(os.path.abspath(__file__))
+    _readobj = os.path.join(
+        _bd, '..', 'third_party', 'llvm-build', 'Release+Asserts',
+        'bin', 'llvm-readobj')
+    _dyn = subprocess.run(
+        [_readobj, '--dynamic-table', path],
+        capture_output=True, text=True, timeout=60).stdout
+    for _line in _dyn.splitlines():
+      _s = _line.strip()
+      for _k in ('NEEDED', 'RUNPATH', 'RPATH', 'RELACOUNT', 'RELA',
+                 'REL', 'BIND_NOW', 'FLAGS'):
+        if _k in _s:
+          print('TERMUX-DEBUG dyn: ' + _s)
+          break
+    _rel = subprocess.run(
+        [_readobj, '--relocations', path],
+        capture_output=True, text=True, timeout=120).stdout
+    _sec, _idx, _counts, _first_odd = None, -1, {}, None
+    for _line in _rel.splitlines():
+      _s = _line.strip()
+      if _s.startswith('Section '):
+        _sec, _idx = _s, -1
+        print('TERMUX-DEBUG section: ' + _s)
+        continue
+      _p = _s.split()
+      if len(_p) >= 2 and _p[0].startswith('0x'):
+        _idx += 1
+        _counts[_p[1]] = _counts.get(_p[1], 0) + 1
+        if (_sec is not None and '.rela.dyn' in _sec
+            and _p[1] not in ('R_X86_64_RELATIVE', 'R_X86_64_RELATIVE64')
+            and _first_odd is None):
+          _first_odd = (_idx, _p[1], _p[0])
+    print('TERMUX-DEBUG reloc counts: %r' % (_counts,))
+    print('TERMUX-DEBUG first non-relative in .rela.dyn: %r' % (_first_odd,))
+    _nm = subprocess.run(
+        ['llvm-nm', path], capture_output=True, text=True,
+        timeout=60).stdout
+    _ffi = sorted({l.split()[-1] for l in _nm.splitlines()
+                   if ' ffi_' in l or ' FFI_' in l})
+    print('TERMUX-DEBUG embedded ffi symbols: %d e.g. %r'
+          % (len(_ffi), _ffi[:5]))
+  except Exception as _e:  # never break the build over diagnostics
+    print('TERMUX-DEBUG inspection failed: %r' % (_e,))
+
 # The rest of the arguments are passed directly to the executable.
 args = [path] + sys.argv[2:]
 
