+// Defined out-of-line so the defaulted destructor is instantiated here,
+// where ui/gfx/geometry/transform.h makes gfx::Transform complete. The
+// header only forward-declares it, and an inline `= default` destructor
+// would delete the incomplete type in any TU that instantiates it (visible
+// with released libc++: unique_ptr.h static_assert 'cannot delete an
+// incomplete type', e.g. xr_cpu_depth_information.cc).
+XRRigidTransform::~XRRigidTransform() = default;
