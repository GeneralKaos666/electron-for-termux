 import argparse
 import os
+import struct
 import subprocess
 import sys
 
@@ -67,8 +68,132 @@
     result = subprocess.call(
         CommandToRun([args.strip, '-o', args.output, args.symbols_file]))
 
+  if result == 0:
+    _DropLoaderNeeded(args.output)
